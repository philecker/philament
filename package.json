{
  "name": "philament",
  "version": "0.1.0",
  "description": "A macOS companion for Bambu Lab printing: unit converter, filament guide and a model library with STL/3MF preview",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:tahoe": "electron-builder --mac --publish never -c.mac.icon=assets/Philament.icon -c.dmg.icon=assets/icon.icns",
    "build:win": "electron-builder --win --publish never",
    "release": "electron-builder --mac --win --publish always"
  },
  "keywords": [
    "3d-printing",
    "bambu-lab",
    "makerworld",
    "filament",
    "converter",
    "utility",
    "macos",
    "windows"
  ],
  "author": {
    "name": "Phil Ecker"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.philament.app",
    "productName": "Philament",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "models.js",
      "model-parsers.js",
      "link-preview.js",
      "saved.js",
      "vendor/**/*",
      "assets/icon.png",
      "assets/icon-dark.png",
      "updater.js",
      "update-ui.js",
      "makerworld.js",
      "makerworld-ui.js"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "artifactName": "Philament-${version}-${arch}-mac.${ext}",
      "minimumSystemVersion": "13.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Philament-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Philament",
      "deleteAppDataOnUninstall": false,
      "buildUniversalInstaller": false
    },
    "dmg": {
      "artifactName": "Philament-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "philecker",
        "repo": "philament",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Phil Ecker"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/philecker/philament.git"
  }
}
